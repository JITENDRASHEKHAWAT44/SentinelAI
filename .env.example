# ==========================================
# SENTINEL AI - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. NVIDIA NIM API Key (Required for LLM generation & embeddings)
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# 2. Database Configuration
# Option A: Full Connection String (Neon / Render / Railway / Supabase)
# DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# Option B: Individual Database Parameters
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelrag
